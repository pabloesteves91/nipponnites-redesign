<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <script>document.documentElement.classList.add('nn-js')</script>
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="robots" content="index, follow">
  {%- comment -%} Sprechende Titel/Beschreibungen für Seiten ohne eigene SEO-Daten im Shop {%- endcomment -%}
  {%- assign _t = page_title -%}{%- assign _d = page_description | default: shop.description -%}
  {%- if template.name == 'collection' and collection.handle == 'all' -%}{%- assign _t = 'JDM Merch & Streetwear: Hoodies, Shirts | Nippon Nites' -%}{%- assign _d = 'Alle JDM-Hoodies, T-Shirts, Caps und Accessoires von Nippon Nites aus Winterthur. Von Hand gezeichnet, auf Bestellung produziert, Versand CH, DE, AT.' -%}
  {%- elsif template.name == 'search' -%}{%- capture _t -%}Suche{% if search.performed %}: {{ search.terms }}{% endif %} | Nippon Nites{%- endcapture -%}
  {%- elsif template.name == '404' -%}{%- assign _t = 'Seite nicht gefunden | Nippon Nites' -%}{%- assign _d = 'Diese Seite gibt es nicht. Zu den Drops von Nippon Nites oder zur Startseite.' -%}
  {%- elsif template.name == 'page' -%}
    {%- case page.handle -%}
      {%- when 'custom' -%}{%- assign _t = 'Custom Merch mit deinem Auto: Hoodie & Shirt | Nippon Nites' -%}{%- assign _d = 'Dein Auto als Unikat auf Hoodie oder T-Shirt, von Hand gezeichnet in Winterthur. Fertig in 1–2 Wochen plus Versand, für jede Automarke.' -%}
      {%- when 'brandstory' -%}{%- assign _t = 'Über uns: Fabio Berta & die Celica | Nippon Nites' -%}{%- assign _d = 'Wie Nippon Nites entstand: Gründer Fabio Berta, ein 1992 Toyota Celica T18 und die Liebe zur JDM-Szene. Handgezeichnete Designs aus Winterthur.' -%}
      {%- when 'brand-story' -%}{%- assign _t = 'Über uns: Fabio Berta & die Celica | Nippon Nites' -%}{%- assign _d = 'Wie Nippon Nites entstand: Gründer Fabio Berta, ein 1992 Toyota Celica T18 und die Liebe zur JDM-Szene. Handgezeichnete Designs aus Winterthur.' -%}
      {%- when 'faq' -%}{%- assign _t = 'FAQ: Versand, Rückgabe & Custom | Nippon Nites' -%}{%- assign _d = 'Antworten zu Lieferzeit in die Schweiz, nach Deutschland und Österreich, Rückgabe, Grössen, Pflege und Custom-Merch mit deinem Auto.' -%}
      {%- when 'contact' -%}{%- assign _t = 'Kontakt | Nippon Nites, JDM-Merch aus Winterthur' -%}{%- assign _d = 'Fragen zur Bestellung, Custom-Idee oder Grosshandel? Schreib Nippon Nites, Im Grüntal 10, 8405 Winterthur. Antwort meist innert 48 Stunden.' -%}
      {%- when 'partner' -%}{%- assign _t = 'Partner werden: Affiliate-Programm | Nippon Nites' -%}{%- assign _d = 'Für Creator, Car-Clubs und Meet-Organisatoren: Empfiehl Nippon Nites mit deinem persönlichen Link und verdien an jeder Bestellung mit.' -%}
      {%- when 'galerie' -%}{%- assign _t = 'Kunden-Galerie: Custom Car Merch | Nippon Nites' -%}{%- assign _d = 'Echte Kundenautos, von Hand gezeichnet und auf Hoodies und Shirts gebracht. Lass dich inspirieren und lass dein eigenes Auto zeichnen.' -%}
    {%- endcase -%}
  {%- endif -%}
  <title>{{ _t | escape }}{% unless _t contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% assign meta_desc = _d %}
  {% if meta_desc %}<meta name="description" content="{{ meta_desc | escape }}">{% endif %}
  {%- comment -%} Link-Vorschau (WhatsApp, Instagram, Facebook): Produktbild → Kollektionsbild → Share-Bild aus Theme-Einstellungen → Logo {%- endcomment -%}
  {%- assign og_type = 'website' -%}
  {%- assign og_img_w = '' -%}
  {%- assign og_img_h = '' -%}
  {%- assign og_img_alt = shop.name -%}
  {%- if template.name == 'product' and product.featured_image -%}
    {%- assign og_img = product.featured_image | image_url: width: 1200 -%}
    {%- assign og_img_alt = product.title -%}
    {%- assign og_type = 'product' -%}
  {%- elsif template.name == 'collection' and collection.image -%}
    {%- assign og_img = collection.image | image_url: width: 1200 -%}
    {%- assign og_img_alt = collection.title -%}
  {%- elsif settings.share_image != blank -%}
    {%- assign og_img = settings.share_image | image_url: width: 1200, height: 630, crop: 'center' -%}
    {%- assign og_img_w = '1200' -%}
    {%- assign og_img_h = '630' -%}
    {%- assign og_img_alt = settings.share_image.alt | default: shop.name -%}
  {%- else -%}
    {%- assign og_img = 'logo_nippon.png' | file_img_url: '1200x630' -%}
  {%- endif -%}
  {%- if og_img contains '//' -%}{%- assign og_img_start = og_img | slice: 0, 2 -%}{%- if og_img_start == '//' -%}{%- assign og_img = og_img | prepend: 'https:' -%}{%- endif -%}{%- endif -%}
  <link rel="icon" type="image/png" href="{{ 'logo_nippon.png' | file_img_url: '64x64' }}">
  <link rel="apple-touch-icon" href="{{ 'logo_nippon.png' | file_img_url: '180x180' }}">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:title" content="{{ _t | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if meta_desc %}<meta property="og:description" content="{{ meta_desc | escape }}">{% endif %}
  <meta property="og:image" content="{{ og_img }}">
  <meta property="og:image:secure_url" content="{{ og_img }}">
  {%- if og_img_w != '' %}
  <meta property="og:image:width" content="{{ og_img_w }}">
  <meta property="og:image:height" content="{{ og_img_h }}">
  {%- endif %}
  <meta property="og:image:alt" content="{{ og_img_alt | escape }}">
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:locale" content="de_CH">
  {%- if template.name == 'product' %}
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ _t | escape }}">
  {% if meta_desc %}<meta name="twitter:description" content="{{ meta_desc | escape }}">{% endif %}
  <meta name="twitter:image" content="{{ og_img }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ shop.name | escape }}",
    "url": "{{ shop.url }}",
    "logo": "{{ 'logo_nippon.png' | file_img_url: '200x200' }}",
    "description": "{{ shop.description | strip_html | escape }}",
    "email": "info@nipponnites.com",
    "foundingDate": "2024",
    "founder": { "@type": "Person", "name": "Fabio Berta", "url": "{{ shop.url }}/pages/brandstory" },
    "areaServed": ["CH", "DE", "AT"],
    "sameAs": ["https://www.instagram.com/nipponnites/", "https://www.tiktok.com/@nippon_nites"],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Im Grüntal 10",
      "addressLocality": "Winterthur",
      "postalCode": "8405",
      "addressRegion": "ZH",
      "addressCountry": "CH"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ shop.name | escape }}",
    "url": "{{ shop.url }}",
    "inLanguage": "de-CH",
    "potentialAction": { "@type": "SearchAction", "target": "{{ shop.url }}/search?q={search_term_string}", "query-input": "required name=search_term_string" }
  }
  </script>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&family=Reenie+Beanie&display=swap" rel="stylesheet">
  {{ 'nn.css' | asset_url | stylesheet_tag }}
</head>
<body class="nn-body template-{{ template.name }}">
  <a class="nn-skip" href="#MainContent">Zum Inhalt springen</a>
  {% section 'ticker-bar' %}
  {% section 'announcement-bar' %}
  {% section 'header' %}
  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% render 'cart-drawer' %}
  <ul hidden><li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li></ul>
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'nn.js' | asset_url }}" defer="defer"></script>
  <button id="scroll-top-btn" type="button" aria-label="Nach oben" class="opacity-0 pointer-events-none"
    style="position:fixed;right:16px;bottom:20px;z-index:40;width:48px;height:48px;border-radius:50%;background:var(--papier);border:2px solid var(--tinte);display:grid;place-items:center;transition:opacity .3s;"
    onclick="window.scrollTo({top:0,behavior:'smooth'})">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
  </button>
</body>
</html>
