<script>window.__moneyFormat = {{ shop.money_format | json }};</script>

<div id="cart-backdrop" class="nn-schleier opacity-0 pointer-events-none" onclick="closeCartDrawer()"></div>

<aside id="cart-drawer" class="nn-zettel translate-x-full" aria-label="Warenkorb">
  <div class="nn-zettel__kopf">
    <div>
      <h2 class="nn-h3">Warenkorb</h2>
      <span class="nn-notiz" style="font-size:1.4rem;">gut ausgewählt</span>
    </div>
    <button type="button" onclick="closeCartDrawer()" class="nn-icon" aria-label="Warenkorb schliessen">
      {% render 'nn-scribble', art: 'kreuz' %}
    </button>
  </div>

  <div id="cart-drawer-items" class="nn-zettel__liste">
    {%- if cart.item_count == 0 -%}
      <div class="nn-zettel__leer">
        <p class="nn-h4">Dein Warenkorb ist leer</p>
        <p class="nn-klein">Schau dich in den Drops um oder lass dein eigenes Auto zeichnen.</p>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="nn-zettel__posten" data-cart-item="{{ item.key }}">
          <a href="{{ item.url }}">
            {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: alt: item.product.title, width: 84, height: 84, loading: 'lazy' }}{%- endif -%}
          </a>
          <div>
            <a href="{{ item.url }}" class="nn-zettel__titel">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}<span class="nn-zettel__variante">{{ item.variant.title }}</span>{%- endunless -%}
            <div class="nn-zettel__zeile">
              <div class="nn-zettel__menge">
                <button type="button" onclick="cartUpdateItem('{{ item.key }}', {{ item.quantity | minus: 1 }})" aria-label="Menge verringern">−</button>
                <span data-item-qty="{{ item.key }}">{{ item.quantity }}</span>
                <button type="button" onclick="cartUpdateItem('{{ item.key }}', {{ item.quantity | plus: 1 }})" aria-label="Menge erhöhen">+</button>
              </div>
              <strong data-item-price="{{ item.key }}">{{ item.final_line_price | money }}</strong>
            </div>
            <button type="button" class="nn-zettel__weg" onclick="cartRemoveItem('{{ item.key }}')" aria-label="{{ item.product.title | escape }} entfernen">Entfernen</button>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="nn-zettel__fuss">
    <div class="nn-zettel__summe"><span>Zwischensumme</span><span id="cart-drawer-subtotal">{{ cart.total_price | money }}</span></div>
    <p class="nn-klein" style="margin:0;">Versand und Rabatte siehst du im Checkout. Jedes Teil wird für dich produziert: Lieferung in 10–20 Werktagen.</p>
    <div id="cart-drawer-cta" style="margin-top:8px;">
      {%- if cart.item_count > 0 -%}
        <a href="/checkout" class="nn-btn nn-btn--marker nn-btn--voll">Zur Kasse</a>
      {%- else -%}
        <a href="/collections/all" class="nn-btn nn-btn--voll">Drops ansehen</a>
      {%- endif -%}
    </div>
  </div>
</aside>
