<section class="nn-seitenkopf nn-wrap">
  <nav class="nn-krumen" aria-label="Brotkrumen"><ol><li><a href="/">Home</a></li><li aria-current="page">Kontakt</li></ol></nav>
  <span class="nn-notiz">Boxenstopp</span>
  <h1 class="nn-h1">Schreib uns</h1>
  <p class="nn-lead">Frage zur Bestellung, Idee für ein Custom oder Anfrage für den Grosshandel: Wir antworten normalerweise innert 48 Stunden.</p>
</section>

<section class="nn-wrap nn-zweispaltig" style="padding-bottom:clamp(56px,8vw,112px);grid-template-columns:1.2fr .8fr;">
  <div class="nn-blatt">
    {% form 'contact', class: 'nn-formular' %}
      {%- if form.posted_successfully? -%}<p class="nn-hinweis" role="status">Danke, deine Nachricht ist da. Wir melden uns.</p>{%- endif -%}
      {%- if form.errors -%}<p class="nn-fehler" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="nn-feld"><label for="contact-name">Name</label><input id="contact-name" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name"></div>
      <div class="nn-feld"><label for="contact-email">E-Mail</label><input id="contact-email" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required></div>
      <div class="nn-feld"><label for="contact-subject">Worum geht's?</label>
        <select id="contact-subject" name="contact[subject]">
          <option value="BESTELLSTATUS">Bestellstatus</option>
          <option value="VERSANDANFRAGE">Versand</option>
          <option value="CUSTOM ANFRAGE">Custom-Anfrage</option>
          <option value="GROSSHANDEL">Grosshandel</option>
        </select>
      </div>
      <div class="nn-feld"><label for="contact-body">Nachricht</label><textarea id="contact-body" name="contact[body]" rows="6">{{ form.body }}</textarea></div>
      <button type="submit" class="nn-btn nn-btn--marker" style="justify-self:start;">Nachricht senden</button>
    {% endform %}
  </div>

  <aside style="display:grid;gap:28px;align-content:start;">
    {% render 'nn-foto', bild: section.settings.hq_image, text: 'Winterthur, unser Zuhause', alt: 'Winterthur', leer_text: 'Winterthur', sizes: '(min-width: 860px) 32vw, 92vw', format: '4 / 3', dreh: '1.5deg' %}
    <div>
      <h2 class="nn-h4" style="margin-bottom:8px;">Adresse</h2>
      <address style="font-style:normal;">Nippon Nites<br>Im Grüntal 10<br>8405 Winterthur ZH<br>Schweiz</address>
      <p style="margin:10px 0 0;"><a class="nn-link" href="mailto:info@nipponnites.com">info@nipponnites.com</a></p>
    </div>
    <div class="nn-auf">
      <details><summary>Versand</summary><div class="nn-auf__inhalt"><p>Bestellungen werden innert 48 Stunden bearbeitet. Lieferung in die Schweiz und nach Deutschland in 7–12 Werktagen, inklusive Produktion. Den Tracking-Link bekommst du per Mail.</p></div></details>
      <details><summary>Rückgabe</summary><div class="nn-auf__inhalt"><p>Rückgabe innert 14 Tagen, ungetragen und mit Etikett. Custom-Teile sind vom Umtausch ausgeschlossen.</p></div></details>
      <details><summary>Grosshandel</summary><div class="nn-auf__inhalt"><p>Wir verlangen 50 % Anzahlung, die Lieferzeit beträgt je nach Verfügbarkeit 4–6 Wochen. Die Details besprechen wir persönlich und halten sie im Vertrag fest.</p></div></details>
    </div>
    <div>
      <h2 class="nn-h4" style="margin-bottom:8px;">Community</h2>
      <p style="display:flex;flex-wrap:wrap;gap:8px 18px;margin:0;">
        {%- if section.settings.instagram_url != blank -%}<a class="nn-link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        <a class="nn-link" href="https://www.tiktok.com/@nippon_nites" target="_blank" rel="noopener">TikTok</a>
        {%- if section.settings.twitter_url != blank -%}<a class="nn-link" href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener">X</a>{%- endif -%}
        {%- if section.settings.discord_url != blank -%}<a class="nn-link" href="{{ section.settings.discord_url }}" target="_blank" rel="noopener">Discord</a>{%- endif -%}
        {%- if section.settings.youtube_url != blank -%}<a class="nn-link" href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}
      </p>
    </div>
  </aside>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hq_image",
      "label": "Tokyo HQ Image"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter / X URL"
    },
    {
      "type": "url",
      "id": "discord_url",
      "label": "Discord URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    }
  ],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}
