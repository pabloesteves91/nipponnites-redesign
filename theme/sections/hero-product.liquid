{%- assign hp = all_products[section.settings.product] -%}
{%- assign hp_alt = all_products[section.settings.product_alt] -%}
<section class="nn-abschnitt" style="background:var(--karton);border-block:2px solid var(--tinte);">
  <div class="nn-wrap nn-duo">
    <div style="position:relative;">
      {% render 'nn-foto', bild: hp.featured_media, alt: hp.title, text: section.settings.eyebrow, sizes: '(min-width: 860px) 45vw, 92vw', format: '1 / 1', dreh: '-2deg', fallen: true, link: hp.url %}
      {%- if section.settings.badge != blank -%}<span style="position:absolute;right:6px;top:-18px;z-index:3;">{% render 'nn-stempel', text: section.settings.badge, klein: true %}</span>{%- endif -%}
    </div>
    <div>
      <h2 class="nn-h2">{{ section.settings.headline_line1 }} <span class="nn-marker">{{ section.settings.headline_outline }}</span></h2>
      {%- if section.settings.text != blank -%}<p class="nn-lead">{{ section.settings.text }}</p>{%- endif -%}
      <div class="nn-wahl">
        {%- for p in (1..2) -%}
          {%- if p == 1 -%}{%- assign _p = hp_alt -%}{%- else -%}{%- assign _p = hp -%}{%- endif -%}
          {%- if _p != blank -%}
            {%- assign _f = 1 -%}{%- if _p.handle contains 'wheelhead-niko' -%}{%- assign _f = 0.85 -%}{%- endif -%}{%- assign _disc = _p.price_min | times: _f | round -%}
            <a href="{{ _p.url }}">
              <strong>{{ _p.title | split: '|' | last | strip | default: _p.title }}</strong>
              <span>{% if p == 1 %}Rückenmotiv gedruckt{% else %}Rückenmotiv komplett gestickt{% endif %}</span>
              <span>{{ _disc | money }}{% if _f != 1 %} <s class="nn-klein">{{ _p.price_min | money }}</s>{% endif %}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.price_note != blank -%}<p class="nn-klein" style="margin-top:14px;">{{ section.settings.price_note }}</p>{%- endif -%}
      <div class="nn-knopfreihe">
        {%- if section.settings.cta_primary_label != blank -%}<a href="{{ section.settings.cta_primary_url | default: hp.url }}" class="nn-btn nn-btn--marker">{{ section.settings.cta_primary_label }}</a>{%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}<a href="{{ section.settings.cta_secondary_url }}" class="nn-btn">{{ section.settings.cta_secondary_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero – Produkt",
  "settings": [
    { "type": "product", "id": "product", "label": "Hauptprodukt (Bild)" },
    { "type": "product", "id": "product_alt", "label": "Alternative Version (für ab-Preis)" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "Neu" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline_line1", "label": "Headline Zeile 1", "default": "WHEELHEAD" },
    { "type": "text", "id": "headline_outline", "label": "Headline Outline", "default": "NIKO" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "price_note", "label": "Hinweis unter Preis" },
    { "type": "text", "id": "cta_primary_label", "label": "Button 1", "default": "Jetzt shoppen" },
    { "type": "url", "id": "cta_primary_url", "label": "Button 1 Link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Button 2", "default": "Alle Drops" },
    { "type": "url", "id": "cta_secondary_url", "label": "Button 2 Link" }
  ],
  "presets": [{ "name": "Hero – Produkt" }]
}
{% endschema %}
