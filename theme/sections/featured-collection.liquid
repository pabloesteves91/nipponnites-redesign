{%- assign coll = collections[section.settings.collection] -%}
{%- assign products = coll.products | default: collections.all.products -%}
<section class="nn-abschnitt nn-wrap">
  <div class="nn-kopfzeile">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="nn-notiz">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="nn-h2">{{ section.settings.title | default: coll.title }}</h2>
    </div>
    <a class="nn-btn" href="{% if coll != blank %}{{ coll.url }}{% else %}/collections/all{% endif %}">Alle ansehen</a>
  </div>
  <div class="nn-raster">
    {%- for product in products limit: section.settings.products_to_show -%}
      {% render 'nn-produktkarte', product: product %}
    {%- else -%}
      <p>Noch keine Produkte in dieser Kollektion.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}{"name":"Featured Collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow text","default":"Featured"},{"type":"text","id":"title","label":"Section title","default":"Shop the Drop"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"Featured Collection"}]}{% endschema %}
