<footer class="nn-footer">
  <div class="nn-wrap">
    <div class="nn-footer__news">
      <div>
        <span class="nn-notiz">Neue Drops zuerst?</span>
        <h2 class="nn-h2" style="margin-top:.2em;">Ab in den Newsletter</h2>
        <p class="nn-klein" style="margin:.6em 0 0;">Etwa einmal im Monat: neue Designs, Custom-Aktionen, Meets. Abmelden geht mit einem Klick.</p>
      </div>
      {% form 'customer', class: 'nn-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="nn-sr" for="nn-news-mail">E-Mail-Adresse</label>
        <input id="nn-news-mail" class="nn-eingabe" type="email" name="contact[email]" placeholder="deine@email.ch" autocomplete="email" required>
        <button type="submit" class="nn-btn nn-btn--marker">Anmelden</button>
        {%- if form.posted_successfully? -%}<p class="nn-hinweis" style="flex-basis:100%;margin:6px 0 0;">Danke, du bist dabei.</p>{%- endif -%}
        {%- if form.errors -%}<p class="nn-fehler" style="flex-basis:100%;margin:6px 0 0;">{{ form.errors | default_errors }}</p>{%- endif -%}
      {% endform %}
    </div>

    <div class="nn-footer__spalten">
      <div>
        <p style="margin:0;max-width:24em;">{{ section.settings.tagline }}</p>
        <div class="nn-footer__social">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
            </a>
          {%- endif -%}
          <a href="{{ section.settings.tiktok_url | default: 'https://www.tiktok.com/@nippon_nites' }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.6 6.7a4.8 4.8 0 0 1-3.8-4.3V2h-3.4v13.7a2.9 2.9 0 1 1-2.1-2.8V9a6.3 6.3 0 1 0 5.5 6.3V8.8a8.3 8.3 0 0 0 4.8 1.5V6.8z"/></svg>
          </a>
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.5 15.6V8.4l6.3 3.6z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div>
        <h2>Shop &amp; Marke</h2>
        <ul>
          {%- for link in linklists[section.settings.footer_menu].links -%}
            {%- assign nav_url = link.url -%}
            {%- assign link_title_lower = link.title | downcase -%}
            {%- if link_title_lower == 'faq' -%}{%- assign nav_url = '/pages/faq' -%}{%- endif -%}
            {%- unless link_title_lower contains 'widerruf' -%}
              <li><a href="{{ nav_url }}">{{ link.title }}</a></li>
            {%- endunless -%}
          {%- endfor -%}
          <li><a href="/pages/sitemap">Sitemap</a></li>
        </ul>
      </div>

      <div>
        <h2>Rechtliches</h2>
        <ul>
          {%- for policy in shop.policies -%}
            {%- assign policy_title_lower = policy.title | downcase -%}
            {%- unless policy_title_lower contains 'widerruf' -%}
              {%- if policy.body != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
          <li><a href="/pages/widerruf-formular">Widerruf</a></li>
        </ul>
      </div>

      <div>
        <h2>Kontakt</h2>
        <address>
          Nippon Nites<br>Im Grüntal 10<br>8405 Winterthur ZH<br>Schweiz
        </address>
        <p style="margin:12px 0 0;"><a class="nn-link" href="mailto:info@nipponnites.com">info@nipponnites.com</a></p>
        <p style="margin:6px 0 0;"><a class="nn-link" href="/pages/contact">Zum Kontaktformular</a></p>
      </div>
    </div>

    <div class="nn-footer__wort">{{ 'nn-logo-word.svg' | inline_asset_content }}</div>

    <div class="nn-footer__basis">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}, Winterthur</span>
      <span>Bezahlen mit TWINT, PayPal oder Karte</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Footer Logo" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Tokyo Underground Streetwear. Hand-illustriert. Bio-Baumwolle." },
    { "type": "link_list", "id": "footer_menu", "label": "Footer Menü", "default": "footer" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
