<section class="nn-wrap" style="padding-block:clamp(36px,5vw,56px);border-block:2px solid var(--tinte);">
  <ul class="nn-check" data-abhaken style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <span class="nn-check__box">{% render 'nn-scribble', art: 'haken', zeichnen: true %}</span>
        <span>{{ block.settings.text }}</span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Vertrauens-Leiste",
  "max_blocks": 4,
  "blocks": [
    { "type": "item", "name": "Punkt", "settings": [
      { "type": "text", "id": "icon", "label": "Icon (wird nicht mehr angezeigt)", "default": "check" },
      { "type": "text", "id": "text", "label": "Text", "default": "Vorteil" }
    ] }
  ],
  "presets": [{ "name": "Vertrauens-Leiste" }]
}
{% endschema %}
