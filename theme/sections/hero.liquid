{%- assign _custom = all_products['custom-hoodie-t-shirt'] -%}
{%- assign _foto3 = section.settings.foto_3 | default: _custom.featured_media -%}
<section class="nn-hero nn-punkte">
  <div class="nn-wrap nn-hero__in">
    <div>
      <h1 class="nn-h1">
        {{ section.settings.headline_line1 }}
        <span class="nn-unter">{{ section.settings.headline_outline }}{% render 'nn-scribble', art: 'unterstrich', zeichnen: true %}</span>
        {{ section.settings.headline_line2 }}
      </h1>
      {%- if section.settings.text != blank -%}<p class="nn-lead">{{ section.settings.text }}</p>{%- endif -%}
      <div class="nn-knopfreihe">
        {%- if section.settings.cta_primary_label != blank -%}
          <a href="{{ section.settings.cta_primary_url | default: '/pages/custom' }}" class="nn-btn nn-btn--marker">{{ section.settings.cta_primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a href="{{ section.settings.cta_secondary_url | default: '/collections/all' }}" class="nn-btn">{{ section.settings.cta_secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="nn-hero__collage">
      {% render 'nn-foto', bild: section.settings.foto_1, text: section.settings.foto_1_text, alt: section.settings.foto_1_text, leer_text: 'Foto folgt: Fabio beim Zeichnen', sizes: '(min-width: 860px) 26vw, 56vw', fallen: true %}
      {% render 'nn-foto', bild: section.settings.foto_2, text: section.settings.foto_2_text, alt: section.settings.foto_2_text, leer_text: 'Foto folgt: die Celica', sizes: '(min-width: 860px) 24vw, 50vw', fallen: true %}
      {% render 'nn-foto', bild: _foto3, text: section.settings.foto_3_text, alt: 'Custom-Hoodie mit handgezeichnetem Kundenauto – Nippon Nites', leer_text: 'Foto folgt', sizes: '(min-width: 860px) 24vw, 50vw', prio: true, format: '1 / 1' %}
      {%- if section.settings.badge != blank -%}{% render 'nn-stempel', text: section.settings.badge %}{%- endif -%}
      <span class="nn-hero__notiz nn-notiz" style="left:56%;top:46%;">echt jetzt.</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero – Skizzenbuch",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "headline_line1",
      "label": "Headline Zeile 1",
      "default": "JDM-Merch,"
    },
    {
      "type": "text",
      "id": "headline_outline",
      "label": "Unterstrichenes Wort",
      "default": "von Hand"
    },
    {
      "type": "text",
      "id": "headline_line2",
      "label": "Headline Zeile 2",
      "default": "gezeichnet."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Dein Auto als Unikat auf Hoodie oder Shirt, in 1–2 Wochen, gezeichnet in Winterthur statt von einer KI generiert."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Stempel",
      "default": "Kein KI"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Button 1",
      "default": "Dein Auto zeichnen lassen"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Button 2",
      "default": "Drops ansehen"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Button 2 Link"
    },
    {
      "type": "header",
      "content": "Collage (3 Polaroids)"
    },
    {
      "type": "image_picker",
      "id": "foto_1",
      "label": "Foto 1 – Fabio beim Zeichnen"
    },
    {
      "type": "text",
      "id": "foto_1_text",
      "label": "Notiz Foto 1",
      "default": "Fabio am Zeichenbrett"
    },
    {
      "type": "image_picker",
      "id": "foto_2",
      "label": "Foto 2 – die Celica"
    },
    {
      "type": "text",
      "id": "foto_2_text",
      "label": "Notiz Foto 2",
      "default": "unsere Celica T18, Bj. 1992"
    },
    {
      "type": "image_picker",
      "id": "foto_3",
      "label": "Foto 3 – Kundenshirt (leer = Bild vom Custom Hoodie)"
    },
    {
      "type": "text",
      "id": "foto_3_text",
      "label": "Notiz Foto 3",
      "default": "Custom für einen Kunden"
    },
    {
      "type": "header",
      "content": "Alt (nicht mehr verwendet)"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "bg_image_alt",
      "label": "Image alt text",
      "default": "Tokyo night street"
    }
  ],
  "presets": [
    {
      "name": "Hero – Skizzenbuch"
    }
  ]
}
{% endschema %}
