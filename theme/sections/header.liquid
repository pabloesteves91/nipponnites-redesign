<header class="nn-header">
  <div class="nn-wrap nn-header__in">
    <a href="/" class="nn-header__logo" aria-label="{{ shop.name }} – Startseite">
      {%- comment -%} SVG-Logo als Standard; das Bild-Setting bleibt als Alternative {%- endcomment -%}
      {%- if section.settings.svg_logo == false and section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, height: 46 }}
      {%- else -%}
        {{ 'nn-logo-mark.svg' | inline_asset_content }}<span>Nippon Nites</span>
      {%- endif -%}
    </a>

    <nav class="nn-nav" aria-label="Hauptnavigation">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}"{% if link.active or link.child_active %} aria-current="page"{% endif %}>{{ link.title }}{% render 'nn-scribble', art: 'unterstrich' %}</a>
      {%- endfor -%}
    </nav>

    <div class="nn-header__tools">
      <a href="/search" class="nn-icon" aria-label="Suchen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.8 21 21"/></svg>
      </a>
      <a href="/account" class="nn-icon" aria-label="Konto">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 21c.8-4 3.8-6 7.5-6s6.7 2 7.5 6"/></svg>
      </a>
      <button type="button" onclick="openCartDrawer()" class="nn-icon" aria-label="Warenkorb öffnen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 8.5h15l-1.3 12h-12.4z"/><path d="M8.5 8.5V7a3.5 3.5 0 0 1 7 0v1.5"/></svg>
        <span data-cart-count class="nn-zaehler"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
      <button type="button" id="mobile-menu-btn" class="nn-icon nn-menu-btn" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menü">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7c5-1 11 1 16 0M4 12.5c6 .8 10-.6 16 0M4 18c5-.8 11 .8 16 0"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nn-mobilnav hidden" aria-label="Mobile Navigation">
    {%- for link in linklists[section.settings.menu].links -%}
      <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "checkbox", "id": "svg_logo", "label": "Gezeichnetes SVG-Logo verwenden", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logo (nur wenn SVG-Logo aus)" },
    { "type": "link_list", "id": "menu", "label": "Navigation", "default": "main-menu" }
  ]
}
{% endschema %}
