<section class="nn-seitenkopf nn-wrap">
  <nav class="nn-krumen" aria-label="Brotkrumen"><ol><li><a href="/">Home</a></li><li aria-current="page">Partner</li></ol></nav>
  <span class="nn-notiz">für Creator, Clubs und Meets</span>
  <h1 class="nn-h1">{{ section.settings.title | default: 'Werde Partner' }}</h1>
  {%- if section.settings.description != blank -%}
    <p class="nn-lead">{{ section.settings.description }}</p>
  {%- else -%}
    <p class="nn-lead">Du fotografierst Autos, organisierst Meets oder hast einen Club? Empfiehl Nippon Nites mit deinem persönlichen Link und verdien an jeder Bestellung mit.</p>
  {%- endif -%}
</section>
<section class="nn-wrap" style="padding-bottom:clamp(56px,8vw,112px);">
  <div class="nn-blatt" style="max-width:760px;">
    {%- for block in section.blocks -%}
      {%- render block -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Partner Page",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "text",     "id": "title",       "label": "Titel",        "default": "Werde Partner" },
    { "type": "textarea", "id": "description",  "label": "Beschreibung" }
  ],
  "presets": [{ "name": "Partner Page" }]
}
{% endschema %}
