{%- assign related_collection = product.collections.first -%}
{%- if related_collection -%}
  {%- assign related_products = related_collection.products -%}
  {%- assign has_related = false -%}
  {%- for p in related_products -%}{%- unless p.id == product.id -%}{%- assign has_related = true -%}{%- endunless -%}{%- endfor -%}
  {%- if has_related -%}
  <section class="nn-abschnitt nn-wrap">
    <div class="nn-kopfzeile">
      <div>
        <span class="nn-notiz">passt dazu</span>
        <h2 class="nn-h2">Ähnliche Drops</h2>
      </div>
      <a class="nn-btn" href="{{ related_collection.url }}">Alle ansehen</a>
    </div>
    <div class="nn-raster">
      {%- assign count = 0 -%}
      {%- for p in related_products -%}
        {%- unless p.id == product.id -%}
          {%- if count < 4 -%}
            {% render 'nn-produktkarte', product: p %}
            {%- assign count = count | plus: 1 -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Cross-Sell",
  "settings": [],
  "presets": [{ "name": "Cross-Sell" }]
}
{% endschema %}
