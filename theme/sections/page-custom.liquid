{%- assign _ch = all_products['custom-hoodie-t-shirt'] -%}
{%- assign _ct = all_products['custom-t-shirt'] -%}
{%- assign _bild = section.settings.passion_image | default: section.settings.hero_image | default: _ch.featured_media -%}
<section class="nn-seitenkopf nn-wrap nn-punkte" style="padding-bottom:clamp(48px,7vw,96px);">
  <nav class="nn-krumen" aria-label="Brotkrumen"><ol><li><a href="/">Home</a></li><li aria-current="page">Custom-Merch</li></ol></nav>
  <div class="nn-hero__in">
    <div>
      <h1 class="nn-h1">{{ section.settings.titel | default: 'Dein Auto auf Merch' }}</h1>
      <p class="nn-lead">{{ section.settings.text }}</p>
      <div class="nn-knopfreihe">
        <a class="nn-btn nn-btn--marker" href="{{ section.settings.cta_url | default: _ch.url }}">{{ section.settings.cta_label | default: 'Custom bestellen' }}</a>
        <a class="nn-btn" href="#custom-ablauf">So läuft's</a>
      </div>
    </div>
    <div style="position:relative;max-width:520px;justify-self:center;width:100%;">
      {% render 'nn-foto', bild: _bild, text: section.settings.bild_text, alt: 'Nippon Nites Community am Car Meet mit Custom-Merch', sizes: '(min-width: 860px) 40vw, 92vw', format: '4 / 3', prio: true, dreh: '2deg' %}
      <span style="position:absolute;left:-14px;bottom:-30px;z-index:3;">{% render 'nn-stempel', text: '1 von 1' %}</span>
    </div>
  </div>
</section>

<section class="nn-abschnitt nn-wrap" style="padding-top:clamp(40px,6vw,80px);">
  <div class="nn-kopfzeile">
    <div>
      <span class="nn-notiz">wähl deine Basis</span>
      <h2 class="nn-h2">Hoodie oder Shirt?</h2>
    </div>
    <p style="max-width:28em;margin:0;">Ärmel-Stickerei links, rechts oder beidseitig für CHF 5.00 pro Seite. Grösse und Stickerei wählst du direkt beim Produkt.</p>
  </div>
  <div class="nn-karten2">
    {%- for _p in (1..2) -%}
      {%- if _p == 1 -%}{%- assign _x = _ct -%}{%- else -%}{%- assign _x = _ch -%}{%- endif -%}
      {%- if _x != blank -%}
        <a href="{{ _x.url }}">
          {{ _x.featured_media | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 600px) 45vw, 92vw', alt: _x.title, loading: 'lazy' }}
          <span class="nn-h3">{{ _x.title }}</span>
          <span>ab <strong>{{ _x.price_min | times: 0.8 | round | money }}</strong> <s class="nn-klein">{{ _x.price_min | money }}</s></span>
          <span class="nn-btn nn-btn--marker" style="justify-self:start;">{% if _p == 1 %}Shirt gestalten{% else %}Hoodie gestalten{% endif %}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<div id="custom-ablauf"></div>

{% schema %}
{
  "name": "Custom-Seite",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Bild im Kopf (leer = Meet-Foto/Custom-Hoodie)"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Text",
      "default": "Custom bestellen"
    },
    {
      "type": "header",
      "content": "3-Step Process"
    },
    {
      "type": "image_picker",
      "id": "step1_image",
      "label": "Step 1 Bild (Hoodie Auswahl)"
    },
    {
      "type": "image_picker",
      "id": "step2_image",
      "label": "Step 2 Bild (Design)"
    },
    {
      "type": "image_picker",
      "id": "step3_image",
      "label": "Step 3 Bild (Packaging)"
    },
    {
      "type": "header",
      "content": "Passion Section"
    },
    {
      "type": "image_picker",
      "id": "passion_image",
      "label": "Passion Bild (Model + Car)"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "text",
      "id": "titel",
      "label": "Titel",
      "default": "Dein Auto auf Merch"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Dein Auto als Einzelstück auf Hoodie oder T-Shirt: von Hand gezeichnet in Winterthur, fertig in 1–2 Wochen plus Versand. JDM, Euro, Daily oder Projekt, wir zeichnen jedes Auto."
    },
    {
      "type": "text",
      "id": "bild_text",
      "label": "Notiz zum Bild",
      "default": "so sieht's am Meet aus"
    }
  ],
  "presets": [
    {
      "name": "Custom Hoodie Page"
    }
  ]
}
{% endschema %}
