<section class="nn-seitenkopf nn-wrap">
  <nav class="nn-krumen" aria-label="Brotkrumen"><ol><li><a href="/">Home</a></li><li aria-current="page">Sitemap</li></ol></nav>
  <h1 class="nn-h1">Sitemap</h1>
</section>
<section class="nn-wrap nn-footer__spalten" style="padding-bottom:clamp(56px,8vw,112px);grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
  <div>
    <h2>Shop</h2>
    <ul>
      <li><a href="/collections/all">Alle Produkte</a></li>
      {%- for collection in collections -%}
        {%- if collection.handle != 'frontpage' and collection.handle != 'all' -%}<li><a href="{{ collection.url }}">{{ collection.title }}</a></li>{%- endif -%}
      {%- endfor -%}
      <li><a href="/pages/custom">Custom-Merch</a></li>
    </ul>
  </div>
  <div>
    <h2>Info</h2>
    <ul>
      <li><a href="/">Startseite</a></li>
      <li><a href="/pages/brandstory">Brand Story</a></li>
      <li><a href="/pages/faq">FAQ</a></li>
      <li><a href="/pages/contact">Kontakt</a></li>
      <li><a href="/pages/partner">Partner</a></li>
      <li><a href="/search">Suche</a></li>
    </ul>
  </div>
  <div>
    <h2>Rechtliches</h2>
    <ul>
      {%- for policy in shop.policies -%}
        {%- assign policy_title_lower = policy.title | downcase -%}
        {%- unless policy_title_lower contains 'widerruf' -%}{%- if policy.body != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}{%- endunless -%}
      {%- endfor -%}
      <li><a href="/pages/widerruf-formular">Widerruf</a></li>
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Sitemap",
  "presets": [{ "name": "Sitemap" }]
}
{% endschema %}
