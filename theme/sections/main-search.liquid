<section class="nn-seitenkopf nn-wrap">
  <span class="nn-notiz">wonach suchst du?</span>
  <h1 class="nn-h1">Suche</h1>
  <form action="/search" method="get" role="search" class="nn-suche">
    <label class="nn-sr" for="nn-suche-q">Suchbegriff</label>
    <input id="nn-suche-q" class="nn-eingabe" type="search" name="q" value="{{ search.terms | escape }}" placeholder="z. B. Hoodie, Supra, Custom">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="nn-btn nn-btn--marker">Suchen</button>
  </form>
  {%- if search.performed -%}
    <p class="nn-klein" style="margin-top:16px;">
      {%- if search.results_count == 0 -%}Keine Treffer für «{{ search.terms | escape }}».{%- else -%}{{ search.results_count }} Treffer für «{{ search.terms | escape }}»{%- endif -%}
    </p>
  {%- endif -%}
</section>

{%- if search.performed -%}
  <section class="nn-wrap" style="padding-bottom:clamp(56px,8vw,112px);">
    {%- if search.results_count == 0 -%}
      <div class="nn-blatt" style="max-width:560px;">
        <p class="nn-h3">Nichts gefunden</p>
        <p>Probier einen kürzeren Begriff, zum Beispiel «Hoodie» oder den Namen deines Autos. Oder schau dir alle Drops an.</p>
        <a href="/collections/all" class="nn-btn nn-btn--marker">Alle Drops ansehen</a>
      </div>
    {%- else -%}
      {% paginate search.results by 12 %}
        <div class="nn-raster">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}{% render 'nn-produktkarte', product: result %}{%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="nn-seiten" aria-label="Seiten">{{ paginate | default_pagination: next: 'Weiter', previous: 'Zurück' }}</nav>{%- endif -%}
      {% endpaginate %}
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Search Page",
  "settings": [],
  "presets": [{ "name": "Search Page" }]
}
{% endschema %}
