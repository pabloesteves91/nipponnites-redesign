{%- assign col = collections[section.settings.collection_handle] -%}
{%- assign products = col.products | default: collections.all.products -%}
{%- assign seen_colls = '' -%}
{%- assign coll_data = '' -%}
{%- for product in products -%}
  {%- for c in product.collections -%}
    {%- assign check = '|' | append: c.handle | append: '|' -%}
    {%- unless seen_colls contains check -%}
      {%- assign seen_colls = seen_colls | append: check -%}
      {%- assign coll_data = coll_data | append: c.title | append: ':::' | append: c.handle | append: '|||' -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign coll_array = coll_data | split: '|||' -%}

<section class="nn-seitenkopf nn-wrap">
  <nav class="nn-krumen" aria-label="Brotkrumen"><ol><li><a href="/">Home</a></li><li aria-current="page">{{ section.settings.title | default: 'Shop' }}</li></ol></nav>
  <span class="nn-notiz">alles von Hand gezeichnet</span>
  <h1 class="nn-h1">{{ section.settings.title | default: 'Shop' }}</h1>
  {%- if section.settings.subtitle != blank -%}<p class="nn-lead">{{ section.settings.subtitle }}</p>{%- endif -%}
</section>

<section class="nn-wrap" style="padding-bottom:clamp(56px,8vw,112px);">
  {%- if coll_array.size > 0 -%}
    <div class="nn-filterleiste">
      <div class="nn-filter" role="group" aria-label="Nach Kollektion filtern">
        <button type="button" onclick="filterByCollection('all', this)" data-filter="all" class="filter-tab is-an" aria-pressed="true">Alle <span>{{ products.size }}</span></button>
        {%- for entry in coll_array -%}
          {%- if entry != blank -%}
            {%- assign parts = entry | split: ':::' -%}
            {%- assign coll_title = parts[0] -%}
            {%- assign coll_handle = parts[1] -%}
            {%- assign coll_count = 0 -%}
            {%- for p in products -%}{%- for c in p.collections -%}{%- if c.handle == coll_handle -%}{%- assign coll_count = coll_count | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
            <button type="button" onclick="filterByCollection('{{ coll_handle | escape }}', this)" data-filter="{{ coll_handle | escape }}" class="filter-tab" aria-pressed="false">{{ coll_title }} <span>{{ coll_count }}</span></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  <p class="nn-klein" style="margin:18px 0 22px;"><span id="product-count">{{ products.size }}</span> Produkte</p>

  {%- if products.size > 0 -%}
    <div class="nn-raster">
      {%- for product in products -%}
        {%- assign product_colls = '' -%}
        {%- for c in product.collections -%}{%- assign product_colls = product_colls | append: c.handle | append: ' ' -%}{%- endfor -%}
        <div class="product-card" data-collections="{{ product_colls | strip }}">
          {%- if forloop.index <= 4 -%}{% render 'nn-produktkarte', product: product, prio: true %}{%- else -%}{% render 'nn-produktkarte', product: product %}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p>Keine Produkte gefunden.</p>
  {%- endif -%}
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var f = new URLSearchParams(window.location.search).get('filter');
  if (f) { var btn = document.querySelector('[data-filter="' + f + '"]'); if (btn) filterByCollection(f, btn); }
});
function filterByCollection(handle, btn) {
  document.querySelectorAll('.filter-tab').forEach(function(b) { b.classList.remove('is-an'); b.setAttribute('aria-pressed', 'false'); });
  btn.classList.add('is-an'); btn.setAttribute('aria-pressed', 'true');
  var visible = 0;
  document.querySelectorAll('.product-card').forEach(function(card) {
    var colls = card.dataset.collections ? card.dataset.collections.split(' ') : [];
    if (handle === 'all' || colls.indexOf(handle) !== -1) { card.style.display = ''; visible++; } else { card.style.display = 'none'; }
  });
  var c = document.getElementById('product-count'); if (c) c.textContent = visible;
}
</script>

{% schema %}
{
  "name": "Oberteile Page",
  "settings": [
    { "type": "text", "id": "title", "label": "Seitentitel", "default": "Oberteile" },
    { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "Hoodies, T-Shirts und mehr." },
    { "type": "collection", "id": "collection_handle", "label": "Collection anzeigen" }
  ],
  "presets": [{ "name": "Oberteile Page" }]
}
{% endschema %}
