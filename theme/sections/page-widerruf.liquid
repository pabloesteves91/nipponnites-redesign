<div class="nn-widerruf nn-wrap">

  <!-- Header -->
  <div>
    <div>
      <p>Verbraucherrechte · EU</p>
      <h1>Widerruf&shy;formular</h1>
      <p>
        Dieses Formular gilt ausschliesslich für Bestellungen, die in die <strong>Europäische Union</strong> geliefert werden. EU-Verbraucher haben gemäss § 355 BGB das Recht, ihren Kauf innerhalb von <strong>14 Tagen</strong> ohne Angabe von Gründen zu widerrufen.
      </p>
      <p>
        Für Bestellungen in die <strong>Schweiz</strong> oder andere Länder gilt kein gesetzliches Widerrufsrecht. Bitte lies unsere <a href="/policies/refund-policy">Rückgabebedingungen</a> und <a href="/policies/terms-of-service">AGB</a>.
      </p>
    </div>
  </div>

  <!-- Form -->
  <div>

    <!-- Company address block -->
    <div>
      <p>An</p>
      <p>
        Nippon Nites<br>
        Fabio Berta<br>
        Im Grüntal 10<br>
        8405 Winterthur ZH<br>
        Switzerland<br>
        <a href="mailto:info@nipponnites.com">info@nipponnites.com</a>
      </p>
    </div>

    {% form 'contact' %}
      {{ form.errors | default_errors }}

      {% if form.posted_successfully? %}
        <div>
          <p>Widerruf eingegangen</p>
          <p>Wir haben deinen Widerruf erhalten und melden uns innerhalb von 1–2 Werktagen per E-Mail.</p>
        </div>
      {% endif %}

      <input type="hidden" name="contact[subject]" value="Widerruf – Bestellung">

      <p>
        Hiermit widerrufe(n) ich/wir den von mir/uns abgeschlossenen Vertrag über den Kauf der folgenden Waren:
      </p>

      <div>

        <!-- Name -->
        <div>
          <label>Vor- und Nachname *</label>
          <input
            type="text"
            name="contact[name]"
            value="{{ form.name }}"
            required
            placeholder="Max Mustermann"
          >
        </div>

        <!-- Email -->
        <div>
          <label>E-Mail-Adresse *</label>
          <input
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            required
            placeholder="deine@email.com"
          >
        </div>

        <!-- Address -->
        <div>
          <label>Anschrift *</label>
          <textarea
            name="contact[anschrift]"
            rows="3"
            required
            placeholder="Strasse, PLZ Ort, Land"
          ></textarea>
        </div>

        <!-- Order Number + Dates -->
        <div>
          <div>
            <label>Bestellnummer *</label>
            <input
              type="text"
              name="contact[bestellnummer]"
              required
              placeholder="#1001"
            >
          </div>
          <div>
            <label>Bestelldatum *</label>
            <input
              type="date"
              name="contact[bestelldatum]"
              required
            >
          </div>
        </div>

        <!-- Received Date -->
        <div>
          <label>Warenerhalt am *</label>
          <input
            type="date"
            name="contact[warenerhalt]"
            required
          >
        </div>

        <!-- Reason (optional) -->
        <div>
          <label>Grund <span>(optional)</span></label>
          <textarea
            name="contact[body]"
            rows="4"
            placeholder="Artikelbeschreibung, Grösse, Farbe ..."
          ></textarea>
        </div>

      </div>

      <!-- Legal note -->
      <p>
        Mit dem Absenden bestätigst du, dass du die <a href="/policies/privacy-policy">Datenschutzerklärung</a> gelesen hast. Deine Angaben werden ausschliesslich zur Bearbeitung deines Widerrufs verwendet.
      </p>

      <!-- Submit -->
      <button class="nn-btn nn-btn--marker"
        type="submit"
      >
        Widerruf verbindlich absenden
      </button>

    {% endform %}

    <!-- Note -->
    <p>
      Du kannst den Widerruf auch formlos per E-Mail an <a href="mailto:info@nipponnites.com">info@nipponnites.com</a> einreichen.
    </p>

  </div>
</div>

{% schema %}
{
  "name": "Widerrufformular",
  "presets": [{ "name": "Widerrufformular" }]
}
{% endschema %}
