{% paginate collection.products by 50 %}

{%- assign seen_types = '|' -%}
{%- assign product_types_raw = '' -%}
{%- for product in collection.products -%}
  {%- if product.type != blank -%}
    {%- assign pt_key = product.type | downcase | prepend: '|' | append: '|' -%}
    {%- unless seen_types contains pt_key -%}
      {%- assign seen_types = seen_types | append: pt_key -%}
      {%- assign product_types_raw = product_types_raw | append: product.type | append: '|||' -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign type_array = product_types_raw | split: '|||' -%}
{%- if collection.handle == 'all' -%}{%- assign col_title = 'Alle Produkte' -%}{%- else -%}{%- assign col_title = collection.title -%}{%- endif -%}

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}"},
  {"@type":"ListItem","position":2,"name":{{ col_title | json }},"item":"{{ shop.url }}{{ collection.url }}"}
]}
</script>

<section class="nn-seitenkopf nn-wrap">
  <nav class="nn-krumen" aria-label="Brotkrumen"><ol><li><a href="/">Home</a></li><li aria-current="page">{{ col_title }}</li></ol></nav>
  <span class="nn-notiz">alles von Hand gezeichnet</span>
  <h1 class="nn-h1">{% if collection.handle == 'all' %}JDM-Merch <span class="nn-unter">aus Winterthur{% render 'nn-scribble', art: 'unterstrich', zeichnen: true %}</span>{% else %}{{ col_title }}{% endif %}</h1>
  {%- if collection.description != blank -%}
    <div class="nn-lead nn-text">{{ collection.description }}</div>
  {%- elsif collection.handle == 'all' -%}
    <p class="nn-lead">Hoodies, T-Shirts, Caps und Accessoires für Leute mit Benzin im Blut. Jedes Motiv entsteht auf dem Zeichenbrett, jedes Teil wird erst nach deiner Bestellung produziert. Versand in die Schweiz, nach Deutschland, Österreich und weltweit.</p>
  {%- endif -%}
</section>

<section class="nn-wrap" style="padding-bottom:clamp(56px,8vw,112px);">
  <div class="nn-filterleiste">
    {%- if type_array.size > 1 -%}
      <div class="nn-filter" role="group" aria-label="Nach Produktart filtern">
        <button type="button" onclick="filterProducts('all', this)" data-filter="all" class="filter-tab is-an" aria-pressed="true">Alle <span>{{ collection.products_count }}</span></button>
        {%- for type in type_array -%}
          {%- if type != blank -%}
            {%- assign type_lower = type | downcase -%}
            {%- assign type_count = 0 -%}
            {%- for p in collection.products -%}
              {%- assign p_lower = p.type | downcase -%}
              {%- if p_lower == type_lower -%}{%- assign type_count = type_count | plus: 1 -%}{%- endif -%}
            {%- endfor -%}
            <button type="button" onclick="filterProducts('{{ type_lower | escape }}', this)" data-filter="{{ type_lower | escape }}" class="filter-tab" aria-pressed="false">{{ type }} <span>{{ type_count }}</span></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <label class="nn-sortieren">
      <span>Sortieren</span>
      <select onchange="window.location = '{{ collection.url }}?sort_by=' + this.value">
        <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Empfohlen</option>
        <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Bestseller</option>
        <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Neueste</option>
        <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Preis aufsteigend</option>
        <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Preis absteigend</option>
      </select>
    </label>
  </div>
  <p class="nn-klein" style="margin:18px 0 22px;"><span id="product-count">{{ collection.products_count }}</span> Produkte</p>

  {%- if collection.products.size > 0 -%}
    <div id="product-grid" class="nn-raster">
      {%- for product in collection.products -%}
        <div class="product-card" data-type="{{ product.type | downcase | escape }}">
          {%- if forloop.index <= 4 -%}{% render 'nn-produktkarte', product: product, prio: true %}{%- else -%}{% render 'nn-produktkarte', product: product %}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="nn-seiten" aria-label="Seiten">{{ paginate | default_pagination: next: 'Weiter', previous: 'Zurück' }}</nav>{%- endif -%}
  {%- else -%}
    <div class="nn-blatt" style="text-align:center;max-width:560px;margin:24px auto;">
      <p class="nn-h3">Hier ist gerade nichts.</p>
      <p>Diese Kollektion ist leer. In allen Drops findest du alles, was es aktuell gibt.</p>
      <a class="nn-btn nn-btn--marker" href="/collections/all">Alle Drops ansehen</a>
    </div>
  {%- endif -%}
</section>

{% endpaginate %}

<script>
function filterProducts(type, btn) {
  document.querySelectorAll('.filter-tab').forEach(function(b) { b.classList.remove('is-an'); b.setAttribute('aria-pressed', 'false'); });
  btn.classList.add('is-an'); btn.setAttribute('aria-pressed', 'true');
  var visible = 0;
  document.querySelectorAll('.product-card').forEach(function(card) {
    if (type === 'all' || card.dataset.type === type) { card.style.display = ''; visible++; } else { card.style.display = 'none'; }
  });
  var c = document.getElementById('product-count'); if (c) c.textContent = visible;
}
</script>

{% schema %}
{
  "name": "Collection Page",
  "settings": [],
  "presets": [{ "name": "Collection Page" }]
}
{% endschema %}
