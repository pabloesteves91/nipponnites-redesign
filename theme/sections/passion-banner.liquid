<section class="nn-passion nn-punkte">
  <div class="nn-wrap">
    <h2 class="nn-h1 nn-passion__schrift">
      {{ section.settings.headline_line1 }}<br>{{ section.settings.headline_line2 }}
      {% render 'nn-scribble', art: 'kreis', klasse: 'nn-passion__kreis', zeichnen: true %}
    </h2>
    {%- if section.settings.subline != blank -%}<p class="nn-notiz" style="display:block;margin-top:28px;">{{ section.settings.subline }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Passion Banner",
  "settings": [
    { "type": "text", "id": "bg_text",        "label": "Hintergrund-Text",   "default": "PASSION" },
    { "type": "text", "id": "headline_line1", "label": "Headline Zeile 1",   "default": "PASSION IS NOT" },
    { "type": "text", "id": "headline_line2", "label": "Headline Zeile 2",   "default": "A CRIME." },
    { "type": "text", "id": "subline",        "label": "Subline",            "default": "Street Heritage // 2024" }
  ],
  "presets": [{ "name": "Passion Banner" }]
}
{% endschema %}
