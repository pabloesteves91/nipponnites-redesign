{%- assign _f_ld = 1 -%}{%- if product.handle == 'custom-hoodie-t-shirt' or product.handle == 'custom-t-shirt' -%}{%- assign _f_ld = 0.8 -%}{%- endif -%}{%- if product.handle == 'wheelhead-niko-light' or product.handle == 'wheelhead-niko-premium' -%}{%- assign _f_ld = 0.85 -%}{%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "description": {{ product.description | strip_html | strip_newlines | truncate: 4900 | json }},
  "image": [{% for image in product.images limit: 6 %}"https:{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  {%- if product.type != blank %}"category": {{ product.type | json }},{% endif %}
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.selected_or_first_available_variant.id | json }},
  "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      "name": {{ v.title | json }},
      "sku": {{ v.sku | default: v.id | json }},
      "price": "{{ v.price | times: _f_ld | round | divided_by: 100.0 }}",
      "priceCurrency": "{{ cart.currency.iso_code }}",
      "availability": "{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition",
      "url": "{{ shop.url }}{{ v.url }}",
      "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- assign _col = product.collections.first -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"{{ shop.url }}"},
  {"@type":"ListItem","position":2,"name":"Shop","item":"{{ shop.url }}/collections/all"},
  {"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":"{{ shop.url }}{{ product.url }}"}
]}
</script>
{%- assign _factor = 1 -%}{%- if product.handle == 'custom-hoodie-t-shirt' or product.handle == 'custom-t-shirt' -%}{%- assign _factor = 0.8 -%}{%- endif -%}{%- if product.handle == 'wheelhead-niko-light' or product.handle == 'wheelhead-niko-premium' -%}{%- assign _factor = 0.85 -%}{%- endif -%}
{%- assign _is_apparel = false -%}
{%- for option in product.options_with_values -%}
  {%- assign _on = option.name | downcase -%}
  {%- if _on contains 'size' or _on contains 'grösse' or _on contains 'größe' -%}{%- assign _is_apparel = true -%}{%- endif -%}
{%- endfor -%}

<div class="nn-wrap" style="padding-top:24px;">
  <nav class="nn-krumen" aria-label="Brotkrumen">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/collections/all">Shop</a></li>
      <li aria-current="page">{{ product.title }}</li>
    </ol>
  </nav>

  <div class="nn-produkt">
    <!-- Bilder -->
    <div>
      <div id="pdp-slider" class="nn-produkt__slider">
        <div id="pdp-slides" class="nn-produkt__spur">
          {%- for image in product.images -%}
            <div class="nn-produkt__bild">
              {%- if forloop.first -%}
                {{ image | image_url: width: 1400 | image_tag: widths: '480, 720, 1000, 1400', sizes: '(min-width: 860px) 55vw, 100vw', alt: image.alt | default: product.title, fetchpriority: 'high', loading: 'eager' }}
              {%- else -%}
                {{ image | image_url: width: 1400 | image_tag: widths: '480, 720, 1000, 1400', sizes: '(min-width: 860px) 55vw, 100vw', alt: image.alt | default: product.title, loading: 'lazy' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {%- if product.images.size > 1 -%}
          <button type="button" class="nn-produkt__pfeil nn-produkt__pfeil--l" onclick="pdpSlide(-1)" aria-label="Vorheriges Bild">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button type="button" class="nn-produkt__pfeil nn-produkt__pfeil--r" onclick="pdpSlide(1)" aria-label="Nächstes Bild">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        {%- endif -%}
        {%- if product.tags contains 'limited' or product.tags contains 'Limited' -%}
          <span class="nn-karte__marke">{% render 'nn-stempel', text: 'Limited' %}</span>
        {%- elsif product.type == 'Custom' -%}
          <span class="nn-karte__marke">{% render 'nn-stempel', text: '1 von 1' %}</span>
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="nn-produkt__daumen">
          {%- for image in product.images -%}
            <button type="button" class="pdp-dot{% if forloop.first %} is-an{% endif %}" onclick="pdpGoTo({{ forloop.index0 }})" aria-label="Bild {{ forloop.index }}">
              {{ image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 80, height: 80 }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <script>
        (function() {
          var _cur = 0, _total = {{ product.images.size }}, _sx = 0;
          function _update() {
            var track = document.getElementById('pdp-slides');
            if (track) track.style.transform = 'translateX(-' + (_cur * 100) + '%)';
            document.querySelectorAll('.pdp-dot').forEach(function(d, i) { d.classList.toggle('is-an', i === _cur); });
          }
          window.pdpSlide = function(dir) { if (_total < 2) return; _cur = (_cur + dir + _total) % _total; _update(); };
          window.pdpGoTo = function(idx) { _cur = idx; _update(); };
          var sl = document.getElementById('pdp-slider');
          if (sl) {
            sl.addEventListener('touchstart', function(e) { _sx = e.touches[0].clientX; }, { passive: true });
            sl.addEventListener('touchend', function(e) { var dx = e.changedTouches[0].clientX - _sx; if (Math.abs(dx) > 40) pdpSlide(dx < 0 ? 1 : -1); }, { passive: true });
          }
        })();
      </script>

      {%- if product.description != blank -%}
        <div class="nn-produkt__details">
          <h2 class="nn-h3">Produktdetails</h2>
          <div class="nn-text">{{ product.description }}</div>
        </div>
      {%- endif -%}
    </div>

    <!-- Kaufbereich -->
    <div class="nn-produkt__info">
      {%- if product.type != blank -%}<span class="nn-notiz">{{ product.type }}</span>{%- endif -%}
      <h1 class="nn-h2" style="margin-top:.15em;">{{ product.title | replace: ' | ', ' · ' }}</h1>

      {%- if _factor != 1 -%}
        {%- assign discounted_price = product.price | times: _factor | round -%}
        <p id="product-price" class="nn-produkt__preis"><span>{{ discounted_price | money }}</span> <s>{{ product.price | money }}</s></p>
      {%- else -%}
        <p id="product-price" class="nn-produkt__preis">{{ product.price | money }}</p>
      {%- endif -%}
      {% render 'star-rating', product: product, show_button: true %}

      {%- if product.metafields.custom.short_description != blank -%}
        <p style="margin:18px 0 0;max-width:34em;">{{ product.metafields.custom.short_description }}</p>
      {%- endif -%}

      {% form 'product', product, id: 'pdp-form', class: 'nn-produkt__form' %}
        {%- for option in product.options_with_values -%}
          {%- assign _oname = option.name | downcase -%}
          <div class="nn-optionen" data-option-index="{{ forloop.index }}">
            <div class="nn-optionen__kopf">
              <span class="nn-optionen__name">{% if _oname == 'size' %}Grösse{% elsif _oname == 'color' %}Farbe{% else %}{{ option.name | replace: 'Größe', 'Grösse' }}{% endif %}</span>
              {%- if _is_apparel and forloop.last -%}
                <button type="button" class="nn-link" onclick="document.getElementById('size-guide-modal').classList.remove('hidden')">Grössentabelle</button>
              {%- endif -%}
            </div>
            <div class="nn-optionen__reihe">
              {%- for value in option.values -%}
                <button type="button" class="nn-wahlknopf{% if forloop.first %} is-an{% endif %}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-option="{{ forloop.parentloop.index }}" data-value="{{ value | escape }}"
                  onclick="selectVariantOption({{ forloop.parentloop.index }}, '{{ value | escape }}', this)">{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- if _is_apparel and forloop.last -%}
            <p class="nn-hinweis" style="margin:-6px 0 18px;">Tipp: lieber eine Nummer grösser.</p>
          {%- endif -%}
        {%- endfor -%}
        <input type="hidden" name="id" id="variant-id" value="{{ product.variants.first.id }}">

        <script>
          var _variants = {{ product.variants | json }};
          var _selected = {};
          {% for option in product.options_with_values %}_selected[{{ forloop.index }}] = {{ option.values.first | json }};
          {% endfor %}
          function selectVariantOption(idx, value, el) {
            _selected[idx] = value;
            var group = el.closest('[data-option-index]');
            group.querySelectorAll('button[data-option]').forEach(function(b) { b.classList.remove('is-an'); b.setAttribute('aria-pressed', 'false'); });
            el.classList.add('is-an'); el.setAttribute('aria-pressed', 'true');
            var match = _variants.find(function(v) { return v.options.every(function(opt, i) { return _selected[i + 1] === opt; }); });
            if (!match) return;
            document.getElementById('variant-id').value = match.id;
            if (match.featured_image && typeof pdpGoTo === 'function') pdpGoTo(match.featured_image.position - 1);
            var fmt = window.__moneyFormat;
            if (!fmt) return;
            var _t1 = '{' + '{amount}}', _t2 = '{' + '{amount_with_comma_separator}}', _t3 = '{' + '{amount_no_decimals}}';
            function f(c) { var a = (c / 100).toFixed(2); return fmt.replace(_t1, a).replace(_t2, a.replace('.', ',')).replace(_t3, String(Math.floor(c / 100))); }
            var discFactor = {{ _factor | default: 1 }};
            var html = discFactor !== 1
              ? '<span>' + f(Math.round(match.price * discFactor)) + '</span> <s>' + f(match.price) + '</s>'
              : f(match.price);
            var priceEl = document.getElementById('product-price');
            if (priceEl) priceEl.innerHTML = html;
            var sp = document.getElementById('nn-sticky-price');
            if (sp) sp.innerHTML = discFactor !== 1 ? f(Math.round(match.price * discFactor)) : f(match.price);
            var btn = document.getElementById('pdp-add');
            if (btn) { btn.disabled = !match.available; btn.textContent = match.available ? 'In den Warenkorb' : 'Ausverkauft'; }
          }
        </script>

        <div style="display:grid;gap:12px;margin-top:6px;">
          {%- if product.available -%}
            <button type="submit" name="add" id="pdp-add" class="nn-btn nn-btn--marker nn-btn--voll">In den Warenkorb</button>
          {%- else -%}
            <button type="button" disabled class="nn-btn nn-btn--voll">Ausverkauft</button>
          {%- endif -%}
          {{ form | payment_button }}
        </div>
      {% endform %}

      <ul class="nn-check nn-produkt__fakten" data-abhaken>
        <li><span class="nn-check__box">{% render 'nn-scribble', art: 'haken', zeichnen: true %}</span><span>{% if product.type == 'Custom' %}Von Hand gezeichnet, 1–2 Wochen Produktion{% else %}Auf Bestellung produziert, 10–20 Werktage{% endif %}</span></li>
        <li><span class="nn-check__box">{% render 'nn-scribble', art: 'haken', zeichnen: true %}</span><span>{% if product.type == 'Custom' %}Einzelstück, darum kein Umtausch{% else %}14 Tage Rückgaberecht{% endif %}</span></li>
        <li><span class="nn-check__box">{% render 'nn-scribble', art: 'haken', zeichnen: true %}</span><span>TWINT, PayPal oder Karte</span></li>
      </ul>

      <div class="nn-auf" style="margin-top:28px;">
        <details>
          <summary>Versand &amp; Rückgabe</summary>
          <div class="nn-auf__inhalt nn-text">
            <p>Jedes Teil wird nach deiner Bestellung für dich produziert. Die Lieferung dauert 10–20 Werktage, mit Sendungsverfolgung (sofern verfügbar). Die Versandkosten siehst du im Checkout.</p>
            <p>Rückgabe innert 14 Tagen für ungetragene, ungewaschene Artikel. Die Kosten für den Rückversand trägst du. Personalisierte Artikel sind von der Rückgabe ausgeschlossen. <a href="/policies/refund-policy">Details</a></p>
          </div>
        </details>
        {%- if _is_apparel -%}
        <details>
          <summary>Material &amp; Pflege</summary>
          <div class="nn-auf__inhalt nn-text"><p>Kalt und auf links waschen. Nicht in den Trockner. Bei niedriger Temperatur bügeln, Druck und Stickerei aussparen.</p></div>
        </details>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if product.available -%}
<div class="nn-sticky" id="nn-sticky" aria-hidden="true">
  <div class="nn-sticky__info">
    <div class="nn-sticky__t">{{ product.title }}</div>
    <div id="nn-sticky-price">{% if _factor != 1 %}{{ product.price | times: _factor | round | money }}{% else %}{{ product.price | money }}{% endif %}</div>
  </div>
  <button type="button" class="nn-btn nn-btn--marker" tabindex="-1" onclick="var b=document.getElementById('pdp-add'); if(b){ if(b.disabled){ b.scrollIntoView({behavior:'smooth',block:'center'}); } else { b.click(); } }">In den Warenkorb</button>
</div>
<script>
  (function(){
    var bar = document.getElementById('nn-sticky'), btn = document.getElementById('pdp-add');
    if (!bar || !btn || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function(entries){
      var e = entries[0];
      bar.classList.toggle('is-visible', !e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(btn);
  })();
</script>
{%- endif -%}

<!-- Grössentabelle -->
<div id="size-guide-modal" class="hidden nn-modal" role="dialog" aria-modal="true" aria-labelledby="size-guide-title">
  <div class="nn-modal__schleier" onclick="document.getElementById('size-guide-modal').classList.add('hidden')"></div>
  <div class="nn-modal__blatt nn-blatt">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
      <h2 id="size-guide-title" class="nn-h3">Grössentabelle</h2>
      <button type="button" class="nn-icon" onclick="document.getElementById('size-guide-modal').classList.add('hidden')" aria-label="Schliessen">{% render 'nn-scribble', art: 'kreuz' %}</button>
    </div>
    <p class="nn-klein" style="margin:0 0 14px;">Alle Masse in Zentimetern (cm)</p>
    <table class="nn-tabelle">
      <thead><tr><th>Grösse</th><th>Brust</th><th>Länge</th><th>Schulter</th><th>Ärmel</th></tr></thead>
      <tbody>
        <tr><th>XS</th><td>86</td><td>64</td><td>41</td><td>62</td></tr>
        <tr><th>S</th><td>92</td><td>66</td><td>43</td><td>64</td></tr>
        <tr><th>M</th><td>100</td><td>68</td><td>46</td><td>66</td></tr>
        <tr><th>L</th><td>108</td><td>72</td><td>49</td><td>68</td></tr>
        <tr><th>XL</th><td>116</td><td>74</td><td>52</td><td>70</td></tr>
        <tr><th>XXL</th><td>124</td><td>76</td><td>55</td><td>72</td></tr>
      </tbody>
    </table>
    <p class="nn-hinweis" style="margin:14px 0 0;">Tipp: lieber eine Nummer grösser.</p>
  </div>
</div>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
